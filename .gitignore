# generated pages and feeds: build_seo.py, build_learn.py and page_shell.py
# rebuild all of these from data.js, and n/ alone is 7,541 files and 88 MB.
n/
h/
rooms/
!_build/museum/src/rooms/
!assets/press/rooms/
learn/
feeds/
/api/
# the Pages Functions and schemas in _build/api are code and must be versioned; only the generated root api/ is ignored
sitemap.xml
llms.txt
llms-full.txt
assets/museum/rooms/

# the scripts keep timestamped copies beside the file they rewrite
*.bak-*
*.pre-*-backup
*.prerename-backup

# per person preview variants (build_variant.mjs)
museum.*.html
assets/museum/museum.*.js
_build/museum/.audit_bundle_*
assets/posters/

# room share cards, rebuilt by _build/build_room_cards.py from MUSEUM EXPORTS (28 MB)
assets/og/rooms/

# the press sheet layout and its downscaled pictures, rebuilt by build_press_pdf.py
_build/press_sheet/

# the full size mosaic is rebuilt by build_mosaic.py; the site ships the four quarters
_build/mosaic/full.jpg

# the two standalone galleries are copied in whole by _build/build_galleries.py from their own repositories
# (MEME ISLAND 2026-10-07, YOUR MOMS BASEMENT 2026-10-08; GitHub branches meme-island and your-moms-basement),
# 180 MB of models and textures; only the share card is versioned here
assets/island/*
!assets/island/poster.jpg
assets/basement/*
!assets/basement/poster.jpg
# THE MARKS GALLERY 2026-10-09 (one night in the city), copied in by build_galleries.py
assets/night/*
!assets/night/poster.jpg
# ON LOCATION 2026-10-10 (New York at the movies), copied in by build_galleries.py
assets/movies/*
!assets/movies/poster.jpg
# MLOW INTERNATIONAL WALK 2026-10-09, copied in by build_galleries.py
assets/airport/*
!assets/airport/poster.jpg
# MoMLOW 2026-10-12 (The MLow Museum, after MoMA), copied in by build_galleries.py; GitHub branch momlow
assets/momlow/*
!assets/momlow/poster.jpg
